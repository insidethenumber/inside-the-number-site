# Force revalidation on every HTML request.
#
# Why this exists (added Aug 20, 2026):
# insidethenumber.com was serving stale HTML from Cloudflare's edge cache
# for hours after a successful deploy, while the underlying
# edge-report.insidethenumber-itn.workers.dev URL served the correct new
# content immediately. On Aug 20 the daily routine pushed the day's picks
# at 10:51am and the public site was STILL showing the previous day's Pick
# of the Day at 3:30pm. Adding a cache-busting query string returned the
# fresh page, which confirmed it was edge caching rather than a failed deploy.
#
# max-age=0 + must-revalidate lets Cloudflare keep a copy but forces it to
# revalidate against the origin before serving, so a new deploy is picked up
# immediately instead of sitting behind a stale cached copy.

/*
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Newsletter images must be readable cross-origin so the beehiiv editor can
# fetch them as blobs and upload them into beehiiv's own media library.
#
# Why (Sep 6, 2026, Chuck: "No graphics, nothing but text. Why?"): beehiiv's
# email renderer ONLY renders imageBlock nodes whose file lives on beehiiv's
# CDN. An <img> or an imageBlock pointing at insidethenumber.com is accepted
# by the editor, looks correct on screen, and is then silently dropped from
# both the email and the web post. The only fix is to get the bytes into
# beehiiv's media library. With file-picker upload unavailable, the working
# path is: fetch the image cross-origin in the beehiiv tab, wrap it in a File,
# and paste it into the editor, which triggers beehiiv's own upload.
/assets/newsletter/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000

# Reels must be readable cross-origin so the video can be pushed straight into
# Instagram's composer from the browser.
#
# Why (Sep 9, 2026): the file-attach tool is unavailable in this session, and
# Instagram's mobile picker only reads the Photos library, so an AirDropped mp4
# sitting in Files is invisible to the app. Chuck went through four
# delete-and-repost cycles because of it. Same fix as the newsletter images
# above: fetch the bytes cross-origin in the Instagram tab, wrap them in a
# File, and hand that to the composer's file input.
/reel.mp4
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/assets/reels/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

# Reels must DOWNLOAD, not stream.
#
# Why (Sep 9, 2026): when iOS Safari opens a direct .mp4 URL it hands the file
# to the built-in video player, and that player's share sheet does not offer
# "Save Video" - so the file can never reach Photos, which is the only place
# Instagram's Reel picker looks. Content-Disposition: attachment makes Safari
# download it to Files instead, and the Files share sheet DOES offer Save Video.
/reel.mp4
  Content-Disposition: attachment; filename="itn-reel.mp4"

/reel2.mp4
  Content-Disposition: attachment; filename="itn-melbourne.mp4"
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/reel3.mp4
  Content-Disposition: attachment; filename="itn-board.mp4"
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/reel4.mp4
  Content-Disposition: attachment; filename="itn-stafford-purdy.mp4"
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/reel5.mp4
  Content-Disposition: attachment; filename="itn-the-calculator.mp4"
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/reel6.mp4
  Content-Disposition: attachment; filename="itn-the-push.mp4"
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
